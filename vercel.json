{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.konoxin.top" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
{
    "version": 2,
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/vapid-public-key",
            "dest": "/api/vapid-public-key.js"
        },
        {
            "src": "/api/subscribe",
            "dest": "/api/subscribe.js"
        },
        {
            "src": "/api/unsubscribe",
            "dest": "/api/unsubscribe.js"
        },
        {
            "src": "/api/send-notification",
            "dest": "/api/send-notification.js"
        }
    ]
}